# ── CereBro harness DB ────────────────────────────────────────────
# Local sqlite by default. Swap to libsql:// for Turso, no code change.
# CEREBRO_DB_URL=file:./cerebro.db
# CEREBRO_DB_AUTH_TOKEN=

# ── Notion (optional, inbox/outbox) ───────────────────────────────
# Internal integration secret from notion.so → Settings → Integrations.
# CereBro never reads or stores this through the chat — set it here only.
# NOTION_TOKEN=
# NOTION_INBOX_DATABASE_ID=
# NOTION_OUTBOX_DATABASE_ID=

# ── Drive vault (optional) ────────────────────────────────────────
# Absolute path to a Google Drive synced folder. CereBro writes outputs
# and source captures into subdirs under this path.
# CEREBRO_VAULT_DIR=/Users/you/Library/CloudStorage/GoogleDrive-…/CereBro

# ── LLM provider (free tiers work, no subscription needed) ───────────
# Option A — Groq (recommended: fast, generous free tier, no card required)
#   Sign up: console.groq.com → API Keys
#   BUILT_IN_FORGE_API_URL=https://api.groq.com/openai
#   BUILT_IN_FORGE_API_KEY=gsk_...
#   CEREBRO_LLM_MODEL=llama-3.3-70b-versatile
#
# Option B — Google AI Studio (Gemini, 1500 req/day free)
#   Sign up: aistudio.google.com → Get API key
#   BUILT_IN_FORGE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   BUILT_IN_FORGE_API_KEY=AIza...
#   CEREBRO_LLM_MODEL=gemini-2.0-flash
#
# Option C — OpenRouter (mix of free models)
#   Sign up: openrouter.ai → Keys
#   BUILT_IN_FORGE_API_URL=https://openrouter.ai/api
#   BUILT_IN_FORGE_API_KEY=sk-or-...
#   CEREBRO_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Per-agent model overrides (optional, Phase 3):
#   CEREBRO_MODEL_CORTANA=llama-3.3-70b-versatile
#   CEREBRO_MODEL_C3PO=llama-3.1-8b-instant

# ── Upstream MySQL stub (unused by CereBro V1, kept for fork compat) ──
DATABASE_URL=mysql://user:password@host:3306/claude_dungeon

# Session signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-random-secret-here

# Optional: Manus OAuth (leave blank to disable auth)
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
